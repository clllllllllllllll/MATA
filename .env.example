# Backend (server-only)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mata_db
JWT_SECRET=<replace-with-strong-random-secret>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload and rate limit baseline
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_MUTATION_PER_MINUTE=60
RATE_LIMIT_REPORT_PER_MINUTE=20
RATE_LIMIT_RESIDENT_ATTENDANCE_PER_MINUTE=30
RATE_LIMIT_GET_PER_MINUTE=300

# Frontend-safe variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=<public-anon-key>
VITE_API_BASE_URL=http://localhost:8000/api/v1
