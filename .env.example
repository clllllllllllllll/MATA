# MATA environment example.
# Use placeholders only. Do not commit real .env files or real secrets.

# ---------------------------------------------------------------------------
# Backend-only server variables
# ---------------------------------------------------------------------------
# These values are read by FastAPI only. Do not expose backend-only values to
# frontend code, Vite build args, or any variable with a VITE_ prefix.
ENV=development
APP_NAME=MATA
DEBUG=true
AUTH_MODE=stub
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/mata_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/mata_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO

# Production/staging backend examples:
# ENV=production
# AUTH_MODE=supabase
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<supabase-host>:5432/<db>
# SYNC_DATABASE_URL=postgresql://<user>:<password>@<supabase-host>:5432/<db>
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_PUBLISHABLE_KEY is safe to use for legacy HS256 Auth-server JWT
# validation. It is not a service-role secret.
# SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key-for-legacy-HS256-token-validation>
# SUPABASE_SERVICE_ROLE_KEY is backend-only. It must never be copied into a
# frontend env file, Vite build arg, browser bundle, or any VITE_* variable.
# SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key-not-used-for-jwt-verification>
# MATA_RESIDENT_SESSION_SECRET signs backend-owned NHG Resident and Non-NHG
# Resident MATA session tokens. It is backend-only and must never be exposed
# through VITE_*.
# MATA_RESIDENT_SESSION_SECRET=<backend-only-random-secret-for-mata-resident-sessions>
# CORS_ORIGINS=https://<frontend-origin>

# ---------------------------------------------------------------------------
# Frontend/browser-exposed Vite variables
# ---------------------------------------------------------------------------
# Every VITE_* value is embedded into the browser bundle. Only put public,
# browser-safe values here. Supabase publishable/anon keys are browser-safe;
# Supabase service-role keys, database URLs, private keys, JWT signing secrets,
# and MATA resident session secrets are not.
# VITE_APP_ENV=production
# VITE_AUTH_MODE=supabase
# VITE_API_BASE_URL=https://<backend-origin>/api/v1
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<public-publishable-key>
# VITE_SUPABASE_ANON_KEY=<legacy-public-anon-key-fallback>
