# MATA environment example.
# Use placeholders only. Do not commit real .env files or real secrets.

# ---------------------------------------------------------------------------
# Backend-only server variables
# ---------------------------------------------------------------------------
# These values are read by FastAPI only. Do not expose backend-only values to
# frontend code, Vite build args, or any variable with a VITE_ prefix.
ENV=development
APP_NAME=MATA
DEBUG=true
AUTH_MODE=stub
AUTH_TRANSPORT=cookie
MATA_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Cookie-session lifecycle. Development/test may use the local fallback hash
# key; production must provide a backend-only value of at least 32 characters.
# MATA_SESSION_HASH_KEY=<backend-only-random-value-at-least-32-characters>
MATA_STAFF_IDLE_TIMEOUT_SECONDS=1800
MATA_STAFF_ABSOLUTE_TIMEOUT_SECONDS=28800
MATA_RESIDENT_IDLE_TIMEOUT_SECONDS=3600
MATA_RESIDENT_ABSOLUTE_TIMEOUT_SECONDS=43200
MATA_SESSION_ROTATION_SECONDS=900
MATA_SESSION_CLEANUP_RETENTION_SECONDS=604800
MATA_SESSION_CLEANUP_BATCH_SIZE=500
MATA_CSRF_HEADER_NAME=X-CSRF-Token

RATE_LIMIT_STORE=memory
# Production requires a backend-only value of at least 32 characters.
# RATE_LIMIT_HASH_SECRET=<backend-only-random-value-at-least-32-characters>
RATE_LIMIT_CLEANUP_RETENTION_SECONDS=86400
RATE_LIMIT_CLEANUP_BATCH_SIZE=500
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/mata_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/mata_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO

# Production/staging backend examples:
# ENV=production
# AUTH_MODE=supabase
# AUTH_TRANSPORT=cookie
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<supabase-host>:5432/<db>
# SYNC_DATABASE_URL=postgresql://<user>:<password>@<supabase-host>:5432/<db>
# MATA_SESSION_HASH_KEY=<backend-only-random-value-at-least-32-characters>
# MATA_ALLOWED_HOSTS=<backend-deployment-hostname>
# RATE_LIMIT_STORE=postgres
# RATE_LIMIT_HASH_SECRET=<backend-only-random-value-at-least-32-characters>
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_PUBLISHABLE_KEY is used by the backend for mediated staff password
# authentication and legacy HS256 Auth-server JWT validation. It is not a
# service-role secret and is not required by the production browser.
# SUPABASE_PUBLISHABLE_KEY=<backend-configured-publishable-or-anon-key>
# SUPABASE_SERVICE_ROLE_KEY is backend-only. It must never be copied into a
# frontend env file, Vite build arg, browser bundle, or any VITE_* variable.
# SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key-not-used-for-jwt-verification>
# MATA_RESIDENT_SESSION_SECRET is rollback-only bearer compatibility and must
# contain at least 32 UTF-8 bytes. Production bearer compatibility also requires
# AUTH_TRANSPORT=bearer_compat and MATA_ENABLE_PRODUCTION_BEARER_ROLLBACK=true.
# MATA_RESIDENT_SESSION_SECRET=<rollback-only-backend-random-secret>
# CORS_ORIGINS=https://<frontend-origin>

# ---------------------------------------------------------------------------
# Frontend/browser-exposed Vite variables
# ---------------------------------------------------------------------------
# Every VITE_* value is embedded into the browser bundle. Only put public,
# browser-safe values here. Production H-D browser authentication and all
# application-data access are backend-mediated; no browser Supabase URL/key is
# required.
# VITE_APP_ENV=production
# VITE_AUTH_MODE=supabase
# VITE_API_BASE_URL=/api/v1
