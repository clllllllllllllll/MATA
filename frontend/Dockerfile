FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . ./

ARG VITE_API_BASE_URL=/api/v1
ARG VITE_APP_ENV=local
ARG VITE_AUTH_MODE=stub
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_APP_ENV=${VITE_APP_ENV}
ENV VITE_AUTH_MODE=${VITE_AUTH_MODE}
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}

ARG VITE_DEMO_ADMIN_USER_ID
ARG VITE_DEMO_ADMIN_PROGRAMME_SCOPE
ARG VITE_DEMO_SECRETARY_USER_ID
ARG VITE_DEMO_SECRETARY_SITE
ARG VITE_DEMO_SECRETARY_SCOPE_LABEL
ARG VITE_DEMO_RESIDENT_USER_ID
ARG VITE_DEMO_RESIDENT_MCR
ARG VITE_DEMO_RESIDENT_PROGRAMME
ARG VITE_DEFAULT_PROGRAMME_CODE
ARG VITE_DEFAULT_REPORTING_PERIOD_ID

ENV VITE_DEMO_ADMIN_USER_ID=${VITE_DEMO_ADMIN_USER_ID}
ENV VITE_DEMO_ADMIN_PROGRAMME_SCOPE=${VITE_DEMO_ADMIN_PROGRAMME_SCOPE}
ENV VITE_DEMO_SECRETARY_USER_ID=${VITE_DEMO_SECRETARY_USER_ID}
ENV VITE_DEMO_SECRETARY_SITE=${VITE_DEMO_SECRETARY_SITE}
ENV VITE_DEMO_SECRETARY_SCOPE_LABEL=${VITE_DEMO_SECRETARY_SCOPE_LABEL}
ENV VITE_DEMO_RESIDENT_USER_ID=${VITE_DEMO_RESIDENT_USER_ID}
ENV VITE_DEMO_RESIDENT_MCR=${VITE_DEMO_RESIDENT_MCR}
ENV VITE_DEMO_RESIDENT_PROGRAMME=${VITE_DEMO_RESIDENT_PROGRAMME}
ENV VITE_DEFAULT_PROGRAMME_CODE=${VITE_DEFAULT_PROGRAMME_CODE}
ENV VITE_DEFAULT_REPORTING_PERIOD_ID=${VITE_DEFAULT_REPORTING_PERIOD_ID}

RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
